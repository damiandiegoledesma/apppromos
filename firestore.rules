rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function currentUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function adminProfile() {
      return get(/databases/$(database)/documents/admins/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return signedIn()
        && adminProfile().active == true
        && (adminProfile().role == "superadmin" || adminProfile().role == "admin");
    }

    function isSuperadmin() {
      return isAdmin()
        || (signedIn() && currentUser().role == "superadmin");
    }

    function ownsBusiness(businessId) {
      return signedIn() && currentUser().businessId == businessId;
    }

    function isOwnerUid() {
      return signedIn()
        && request.resource.data.ownerUid is string
        && request.resource.data.ownerUid == request.auth.uid;
    }

    function isValidPublicSignalId(signalId, signalType) {
      return signalId.size() <= 120
        && (
          (signalType == 'external_storefront_visit'
            && signalId.matches('^external_storefront_visit_[0-9]{8}_[A-Za-z0-9]{1,32}$'))
          || (signalType == 'public_order_whatsapp_started'
            && signalId.matches('^public_order_whatsapp_started_[0-9]{8}_[A-Za-z0-9]{1,32}$'))
        );
    }

    function hasValidPublicSignalMetadata(signalType, metadata) {
      return metadata is map
        && (
          (signalType == 'external_storefront_visit'
            && metadata.keys().hasOnly([]))
          || (signalType == 'public_order_whatsapp_started'
            && metadata.keys().hasAll([
              'itemCount', 'containsOffer', 'containsDailyOffer'
            ])
            && metadata.keys().hasOnly([
              'itemCount', 'containsOffer', 'containsDailyOffer'
            ])
            && metadata.itemCount is int
            && metadata.itemCount >= 1
            && metadata.itemCount <= 99
            && metadata.containsOffer is bool
            && metadata.containsDailyOffer is bool)
        );
    }

    match /admins/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin() || isSuperadmin());
      allow create, update, delete: if isSuperadmin();
    }

    match /adminActions/{actionId} {
      allow read: if isAdmin() || isSuperadmin();
      allow create: if isAdmin() || isSuperadmin();
      allow update, delete: if false;
    }

    match /users/{uid} {
      allow read, write: if signedIn() && (request.auth.uid == uid || isAdmin() || isSuperadmin());
    }

    match /businesses/{businessId} {
      allow read: if ownsBusiness(businessId) || isAdmin() || isSuperadmin();
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if ownsBusiness(businessId) || isAdmin() || isSuperadmin();
      allow delete: if (isAdmin() || isSuperadmin()) && resource.data.isTestBusiness == true;
    }

    match /businesses/{businessId}/commercialEvents/{eventId} {
      allow read: if ownsBusiness(businessId) || isAdmin() || isSuperadmin();
      allow create: if (ownsBusiness(businessId) || isAdmin() || isSuperadmin())
        && request.resource.data.keys().hasAll([
          'businessId', 'type', 'occurredAt', 'createdAt', 'origin',
          'actorType', 'source', 'metadata', 'schemaVersion'
        ])
        && request.resource.data.keys().hasOnly([
          'businessId', 'type', 'occurredAt', 'createdAt', 'origin',
          'actorType', 'source', 'metadata', 'schemaVersion'
        ])
        && request.resource.data.businessId == businessId
        && request.resource.data.schemaVersion == 1
        && request.resource.data.type in [
          'business_registered', 'first_login', 'app_open', 'price_save',
          'price_milestone_reached', 'web_open', 'web_share', 'offer_created',
          'offer_published', 'offer_shared', 'seller_whatsapp',
          'daily_promo_created', 'daily_promo_published',
          'business_identity_completed',
          'storefront_theme_offered', 'storefront_theme_previewed',
          'storefront_theme_selected', 'storefront_theme_deferred'
        ]
        && request.resource.data.occurredAt is string
        && (request.resource.data.createdAt is timestamp || request.resource.data.createdAt is string)
        && request.resource.data.origin is string
        && request.resource.data.origin.size() <= 40
        && request.resource.data.source is string
        && request.resource.data.source.size() <= 80
        && (
          (ownsBusiness(businessId) && request.resource.data.actorType == 'owner')
          || ((isAdmin() || isSuperadmin()) && request.resource.data.actorType in ['admin', 'system'])
        )
        && request.resource.data.metadata is map
        && request.resource.data.metadata.keys().hasOnly([
          'milestone', 'pricedProductCount', 'changedProductCount', 'theme'
        ]);
      allow update, delete: if false;
    }

    match /businesses/{businessId}/publicSignals/{signalId} {
      allow read: if ownsBusiness(businessId) || isAdmin() || isSuperadmin();
      allow create: if exists(/databases/$(database)/documents/businesses/$(businessId))
        && request.resource.data.keys().hasAll([
          'businessId', 'type', 'occurredAt', 'createdAt', 'origin',
          'source', 'metadata', 'schemaVersion'
        ])
        && request.resource.data.keys().hasOnly([
          'businessId', 'type', 'occurredAt', 'createdAt', 'origin',
          'source', 'metadata', 'schemaVersion'
        ])
        && request.resource.data.businessId == businessId
        && request.resource.data.schemaVersion == 1
        && request.resource.data.type in [
          'external_storefront_visit', 'public_order_whatsapp_started'
        ]
        && isValidPublicSignalId(signalId, request.resource.data.type)
        && request.resource.data.occurredAt is string
        && request.resource.data.occurredAt.size() == 24
        && request.resource.data.occurredAt.matches(
          '^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}[.][0-9]{3}Z$'
        )
        && request.resource.data.createdAt is timestamp
        && request.resource.data.origin == 'public_web'
        && (
          (request.resource.data.type == 'external_storefront_visit'
            && request.resource.data.source == 'storefront_load')
          || (request.resource.data.type == 'public_order_whatsapp_started'
            && request.resource.data.source == 'public_cart')
        )
        && hasValidPublicSignalMetadata(
          request.resource.data.type,
          request.resource.data.metadata
        );
      allow update, delete: if false;
    }

    match /businesses/{businessId}/followupEvents/{eventId} {
      allow read: if isAdmin() || isSuperadmin();
      allow create: if (isAdmin() || isSuperadmin())
        && request.resource.data.keys().hasAll([
          'businessId', 'type', 'occurredAt', 'createdAt', 'status',
          'outcome', 'nextAction', 'nextContactAt', 'note',
          'operatorUid', 'operatorEmail', 'schemaVersion'
        ])
        && request.resource.data.keys().hasOnly([
          'businessId', 'type', 'occurredAt', 'createdAt', 'status',
          'outcome', 'nextAction', 'nextContactAt', 'note',
          'operatorUid', 'operatorEmail', 'schemaVersion'
        ])
        && request.resource.data.businessId == businessId
        && request.resource.data.type == 'manual_followup_updated'
        && request.resource.data.schemaVersion == 1
        && request.resource.data.status in [
          'pending', 'contacted', 'helped', 'resolved', 'no_response'
        ]
        && request.resource.data.occurredAt is string
        && request.resource.data.createdAt is timestamp
        && request.resource.data.outcome is string
        && request.resource.data.outcome.size() <= 240
        && request.resource.data.nextAction is string
        && request.resource.data.nextAction.size() <= 240
        && (request.resource.data.nextContactAt == null || request.resource.data.nextContactAt is string)
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 1000
        && request.resource.data.operatorUid is string
        && request.resource.data.operatorEmail is string;
      allow update, delete: if false;
    }

    match /businesses/{businessId}/followupState/{stateId} {
      allow read: if isAdmin() || isSuperadmin();
      allow create, update: if (isAdmin() || isSuperadmin())
        && stateId == 'current'
        && request.resource.data.keys().hasAll([
          'status', 'outcome', 'nextAction', 'nextContactAt', 'note',
          'updatedAt', 'updatedByUid', 'updatedByEmail'
        ])
        && request.resource.data.keys().hasOnly([
          'status', 'outcome', 'nextAction', 'nextContactAt', 'note',
          'updatedAt', 'updatedByUid', 'updatedByEmail'
        ])
        && request.resource.data.status in [
          'pending', 'contacted', 'helped', 'resolved', 'no_response'
        ]
        && request.resource.data.outcome is string
        && request.resource.data.outcome.size() <= 240
        && request.resource.data.nextAction is string
        && request.resource.data.nextAction.size() <= 240
        && (request.resource.data.nextContactAt == null || request.resource.data.nextContactAt is string)
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 1000
        && request.resource.data.updatedAt is string
        && request.resource.data.updatedByUid is string
        && request.resource.data.updatedByEmail is string;
      allow delete: if false;
    }

    match /businesses/{businessId}/{collectionId}/{document=**} {
      allow read: if collectionId != 'followupEvents' && collectionId != 'followupState'
        && (ownsBusiness(businessId) || isAdmin() || isSuperadmin());
      allow create: if collectionId != 'commercialEvents' && collectionId != 'publicSignals' && collectionId != 'followupEvents' && collectionId != 'followupState'
        && signedIn()
        && (ownsBusiness(businessId) || isAdmin() || isSuperadmin() || request.resource.data.ownerUid == request.auth.uid);
      allow update, delete: if collectionId != 'commercialEvents' && collectionId != 'publicSignals' && collectionId != 'followupEvents' && collectionId != 'followupState'
        && (ownsBusiness(businessId) || isAdmin() || isSuperadmin());
    }

    match /publicWebSlugs/{slug} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.businessId is string
        && (isOwnerUid() || ownsBusiness(request.resource.data.businessId) || isAdmin() || isSuperadmin());
      allow update: if signedIn()
        && request.resource.data.businessId is string
        && (ownsBusiness(request.resource.data.businessId) || isAdmin() || isSuperadmin());
      allow delete: if signedIn()
        && (ownsBusiness(resource.data.businessId) || isAdmin() || isSuperadmin());
    }

    match /publicPhoneKeys/{phoneKey} {
      // V11.4.1: registro público necesita consultar duplicados antes de crear Auth.
      // El documento de índice debe mantenerse mínimo: businessId, phoneKey, active, updatedAt.
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.businessId is string
        && (
          getAfter(/databases/$(database)/documents/businesses/$(request.resource.data.businessId)).data.ownerUid == request.auth.uid
          || isOwnerUid()
          || ownsBusiness(request.resource.data.businessId)
          || isAdmin()
          || isSuperadmin()
        );
      allow update: if signedIn()
        && request.resource.data.businessId is string
        && (ownsBusiness(request.resource.data.businessId) || isAdmin() || isSuperadmin());
      allow delete: if signedIn()
        && (ownsBusiness(resource.data.businessId) || isAdmin() || isSuperadmin());
    }

    match /marketSnapshots/{businessId} {
      allow read: if signedIn();
      allow create, update, delete: if ownsBusiness(businessId) || isAdmin() || isSuperadmin();
    }

    match /catalogs/{document=**} {
      allow read: if signedIn();
      allow write: if isAdmin() || isSuperadmin();
    }
  }
}
